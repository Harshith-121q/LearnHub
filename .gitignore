# ==========================================
# LearnHub Root .gitignore
# ==========================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Environment variables & secrets
.env
.env.local
.env.*.local
!.env.example

# Node.js & Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Java & Backend (Maven)
backend/target/
backend/data/
*.db
*.class
*.jar
*.war
*.ear
backend/*.log

# IDE & Editor Configurations
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.factorypath

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Crash logs
hs_err_pid*
replay_pid*
